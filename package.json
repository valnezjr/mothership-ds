{
  "name": "mothership-ds",
  "version": "1.0.1",
  "description": "Design system em React + TypeScript: glassmorphism, temas claro/escuro, fundo animado e 31 componentes sem dependências de runtime.",
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "ui",
    "components",
    "glassmorphism",
    "dark-mode",
    "nextjs",
    "css-variables",
    "design-tokens"
  ],
  "author": "Valnez Júnior <valn3zjr@gmail.com> (Mothership Studios)",
  "license": "MIT",
  "homepage": "https://valnezjr.github.io/mothership-ds/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valnezjr/mothership-ds.git"
  },
  "bugs": {
    "url": "https://github.com/valnezjr/mothership-ds/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./components.css": "./src/styles/components.css",
    "./reset.css": "./src/reset.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "styleguide": "node styleguide/build.mjs",
    "styleguide:dev": "node styleguide/build.mjs --serve"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4",
    "esbuild": "^0.23.0"
  }
}
