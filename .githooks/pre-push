#!/bin/sh
# Etapa 6.5 (Mothership Agency) — o guardião do DS, primeiro agente real.
#
# Dispara por push (nunca por save/commit — silêncio é o padrão). Roda a
# skill design-system-maintainer sobre o diff sendo enviado; se ela achar
# algo digno de nota, escreve um relatório num arquivo que a Mothership
# Agency (quando aberta) descobre sozinha — nada aqui depende de um
# servidor estar de pé no momento do push (ver DECISOES.md da Agency).
#
# Autonomia mínima: só leitura (--allowedTools abaixo), nunca escreve no
# repositório do DS. Um hook nunca deve bloquear o push por conta própria
# — todo caminho de erro sai 0.

set -u

REPO_RAIZ=$(cd "$(dirname "$0")/.." && pwd)
cd "$REPO_RAIZ" || exit 0

# .../Projetos/MothershipDesignSystem/mothership-ds -> .../Projetos/Mothership Agency
AGENCY_RAIZ="$(dirname "$(dirname "$REPO_RAIZ")")/Mothership Agency"
DESTINO="$AGENCY_RAIZ/.guardioes/relatorios"

if [ ! -d "$AGENCY_RAIZ" ]; then
  exit 0
fi

# Protocolo padrão de pre-push: uma linha por ref sendo empurrada.
# <local ref> <local sha1> <remote ref> <remote sha1>
ALGO_RELEVANTE=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "$LOCAL_SHA" ] && continue
  if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
    # branch nova — sem base remota pra comparar, olha só o último commit
    ARQUIVOS=$(git diff --name-only HEAD~1..HEAD 2>/dev/null || git show --name-only --pretty="" "$LOCAL_SHA")
  else
    ARQUIVOS=$(git diff --name-only "$REMOTE_SHA".."$LOCAL_SHA")
  fi
  if echo "$ARQUIVOS" | grep -qE '^(src/|styles/|styleguide/stories\.tsx)'; then
    ALGO_RELEVANTE=1
    DIFF_SHA="$LOCAL_SHA"
    DIFF_BASE="$REMOTE_SHA"
  fi
done

if [ "$ALGO_RELEVANTE" != "1" ]; then
  exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
  exit 0
fi

# Ferramentas restritas por fora — reforça o que a skill já promete por
# dentro ("só reporta, nunca corrige"). Sem Edit/Write em lugar nenhum.
RESULTADO=$(claude -p "/design-system-maintainer Audite as mudanças entre $DIFF_BASE e $DIFF_SHA (rode git diff você mesma para ver o conteúdo). Sem itens obrigatórios nem sugestões, diga apenas 'Nada a reportar.'" \
  --output-format json \
  --permission-mode dontAsk \
  --permission-prompts none \
  --allowedTools "Read,Bash(git diff *),Bash(git log *),Bash(git show *),Bash(git status)" \
  2>/dev/null) || exit 0

[ -z "$RESULTADO" ] && exit 0

RELATORIO=$(printf '%s' "$RESULTADO" | node -e '
  let entrada = "";
  process.stdin.on("data", (d) => (entrada += d));
  process.stdin.on("end", () => {
    try {
      const json = JSON.parse(entrada);
      const texto = String(json.result ?? "");
      if (/nada a reportar/i.test(texto.trim())) { process.exit(0); }
      const veredito = /❌|reprovado/i.test(texto) ? "reprovado" : /⚠️|ressalvas/i.test(texto) ? "ressalvas" : "aprovado";
      const scoreMatch = texto.match(/Score:\**\s*(\d+)\/100/i);
      process.stdout.write(JSON.stringify({
        relatorio: texto,
        veredito,
        score: scoreMatch ? Number(scoreMatch[1]) : null,
      }));
    } catch {
      process.exit(0);
    }
  });
' 2>/dev/null) || exit 0

[ -z "$RELATORIO" ] && exit 0

mkdir -p "$DESTINO" 2>/dev/null || exit 0

COMMIT="${DIFF_SHA:-desconhecido}"
ARQUIVO="$DESTINO/$(date +%s)-${COMMIT}.json"

node -e '
  const fs = require("fs");
  const dados = JSON.parse(process.argv[1]);
  dados.commit = process.argv[2];
  dados.em = Date.now();
  fs.writeFileSync(process.argv[3], JSON.stringify(dados, null, 2));
' "$RELATORIO" "$COMMIT" "$ARQUIVO" 2>/dev/null

exit 0
